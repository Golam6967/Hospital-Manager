# ─── Hospital Service Environment Variables ───────────────────────────────────
# Copy to .env and fill in all values before running

# Server
PORT=3002
NODE_ENV=development

# MongoDB Atlas — your existing Atlas cluster
# e.g. mongodb+srv://user:pass@cluster.mongodb.net/hospital-manager?retryWrites=true&w=majority
MONGODB_URI=<YOUR_ATLAS_URI>

# Gateway internal secret — requests without this header are rejected
# Must be the same value as in auth-service/.env and gateway/.env
GATEWAY_SECRET=<same-random-hex-as-gateway>

# CORS — restrict to the internal gateway only
# In Docker: http://gateway:3000
# For local dev (no Docker): http://localhost:3000
CORS_ORIGIN=http://gateway:3000
