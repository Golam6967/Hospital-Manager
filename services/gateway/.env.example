# ─── Gateway Environment Variables ───────────────────────────────────────────
# Copy to .env and fill in all values before running

# Server
PORT=3000
NODE_ENV=development

# Downstream service URLs
# In Docker (uses Docker network service names):
AUTH_SERVICE_URL=http://auth-service:3001
HOSPITAL_SERVICE_URL=http://hospital-service:3002
# For local dev (no Docker):
# AUTH_SERVICE_URL=http://localhost:3001
# HOSPITAL_SERVICE_URL=http://localhost:3002

# JWT Access token verification
# Must be the exact same secret as JWT_ACCESS_SECRET in auth-service/.env
JWT_ACCESS_SECRET=<same-secret-as-auth-service>

# Gateway → Service authentication header
# Must match GATEWAY_SECRET in auth-service/.env and hospital-service/.env
GATEWAY_SECRET=<same-random-hex>

# CORS — allow the browser/frontend (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
