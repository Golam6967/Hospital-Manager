# MongoDB Connection URI
# Replace with your actual MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?appName=AppName

# Server Port (optional, defaults to 5000)
PORT=5000

# Node Environment
NODE_ENV=development

# JWT Configuration
# Generate a strong secret key for JWT signing
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Configuration (optional, defaults to "*" which allows all origins)
CORS_ORIGIN=http://localhost:3000

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT=firebase.admin.json

# Gmail Configuration (optional, for notifications)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Groq API Key (optional)
GROQ_API_KEY=your-groq-api-key

